{
  "name": "@jackchuka/bnpm",
  "version": "0.1.0",
  "description": "Better (p)npm: the same npm or pnpm with an interactive layer. Missing arguments become prompts, and `mine` manages the packages you publish.",
  "keywords": [
    "cli",
    "deprecate",
    "interactive",
    "npm",
    "packages",
    "pnpm",
    "publisher",
    "registry",
    "tui"
  ],
  "license": "MIT",
  "author": "jackchuka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackchuka/bnpm.git"
  },
  "homepage": "https://github.com/jackchuka/bnpm#readme",
  "bugs": "https://github.com/jackchuka/bnpm/issues",
  "type": "module",
  "bin": {
    "bnpm": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --silent && node dist/cli.js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@npmcli/config": "11.0.1",
    "chalk": "6.0.0",
    "ink": "7.1.1",
    "npm-registry-fetch": "20.0.1",
    "react": "19.3.0",
    "semver": "7.8.5",
    "validate-npm-package-name": "8.0.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/npm-registry-fetch": "8.0.9",
    "@types/react": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/validate-npm-package-name": "4.0.2",
    "ink-testing-library": "4.0.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
